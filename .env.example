# ============================================================
# Sponsorship Bridge — Environment Variables
# ============================================================

# --- Google Cloud (required) ---
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=europe-west1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# --- YouTube Data API (required) ---
YOUTUBE_API_KEY=your-youtube-api-key-here

# Demo-safe default: one YouTube search query per search tool call.
# Set to true only when you want broader discovery and have quota headroom.
YOUTUBE_QUERY_VARIANTS=false

# --- Google Calendar ---
#
# USE_REAL_CALENDAR controls whether the calendar MCP server uses
# real Google Calendar API calls or stub data.
#
#   false (default) = stub mode, safe for Week 1 development
#   true            = real API mode, requires CALENDAR_TOKEN_JSON to be set
#
USE_REAL_CALENDAR=false

# CALENDAR_TOKEN_JSON is only needed when USE_REAL_CALENDAR=true.
# To generate it:
#   1. Download credentials.json from GCP Console (OAuth 2.0 Client ID, Desktop app type)
#   2. Run: python3 auth_setup.py
#   3. Copy the full contents of the generated token.json here as a single-line JSON string
#
# Both credentials.json and token.json are in .gitignore — never commit them.
#
# CALENDAR_TOKEN_JSON={"token":"...","refresh_token":"...","client_id":"...","client_secret":"..."}
